generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Plan {
  BASIC
  PRO
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  plan      Plan     @default(BASIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bots      BotConfig[]
}

model BotConfig {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  botToken    String    @unique
  botUsername String?
  bankName    String?
  bankAccount String?
  bankOwner   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      Order[]
}

model Product {
  id          Int       @id @default(autoincrement())
  botId       Int
  bot         BotConfig @relation(fields: [botId], references: [id])
  name        String
  price       Float
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id             Int         @id @default(autoincrement())
  botId          Int
  bot            BotConfig   @relation(fields: [botId], references: [id])
  customerTeleId String
  totalAmount    Float
  status         OrderStatus @default(PENDING)
  paymentCode    String      @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
